#!/usr/bin/env bash
# screencomp local pre-push guard — the strict gate's local half, adapted for
# this affected-only Nx monorepo.
#
# CI (.github/workflows/visual-docs.yml) hard-fails when a microfrontend's
# capture drifts from its committed baseline manifest. This hook lets you
# regenerate and COMMIT the new baseline before pushing, so CI stays green on
# intended changes and goes red only on ones you missed. It re-captures ONLY when
# screenshot-relevant files change (see [guard].paths in screencomp.toml), and
# only the microfrontends Nx reports affected — matching CI's affected matrix.
#
# The loop when you change something visual: edit, then `git push`. If nothing
# screenshot-relevant changed the hook is a no-op; if it did, it captures the
# affected apps in the SAME pinned container CI uses and, on drift, regenerates
# each drifted app's baseline manifest, builds a review gallery, and BLOCKS —
# then you review the gallery, `git add` the manifest(s), commit, and push again.
# It never auto-commits. `git push --no-verify` bypasses it; under CI it no-ops.
#
# Enable once per clone:  git config core.hooksPath .githooks

set -euo pipefail

# Captures always run in a Linux container, so only the CPU arch varies. This
# repo maintains x86_64 (screencomp.toml [capture].arches); the container capture
# reproduces those bytes regardless of the host CPU.
ARCH="x86_64"
CONTAINER="mcr.microsoft.com/playwright:v1.61.1-noble"
CONFIG="${SCREENCOMP_CONFIG:-screencomp.toml}"

# Under `set -e` a failing command substitution kills the hook where it stands,
# so git reports only "failed to push some refs" and the reason the hook knew is
# lost. Every exit that is not a clean verdict is therefore routed through one of
# these two announcements, and neither is silent. Only an evaluated pass — no
# screenshot-relevant change, or every affected app matching its baseline — is
# allowed to be quiet.

# The guard never formed an opinion — a tool it needs is missing or broke. It
# says so and lets the push through: refusing a push it never evaluated is
# indistinguishable, from the pusher's side, from finding real drift, and CI's
# 'Visual docs' classify-gate is the authoritative gate either way.
# SCREENCOMP_GUARD_REQUIRE=1 turns every such skip into a hard failure.
# llmlint: ignore[changed_behavior_has_e2e] This local Git hook has no browser or render path; visual-guard-hook.spec.ts drives the real executable through git's pre-push stdin protocol and covers evaluated passes, unevaluated skips, required failures, and drift-related refusal.
skip_unevaluated() {
  local reason="$1"
  shift
  {
    echo
    echo "pre-push: the screencomp visual guard could NOT evaluate this push."
    echo "          reason: $reason"
    local detail
    for detail in "$@"; do echo "          $detail"; done
    if [ -n "${SCREENCOMP_GUARD_REQUIRE:-}" ]; then
      echo "          Refusing the push because SCREENCOMP_GUARD_REQUIRE is set."
    else
      echo "          Skipping the guard and allowing the push; CI's 'Visual docs'"
      echo "          classify-gate still gates this change."
      echo "          Set SCREENCOMP_GUARD_REQUIRE=1 to fail here instead of skipping."
    fi
    echo
  } >&2
  if [ -n "${SCREENCOMP_GUARD_REQUIRE:-}" ]; then exit 1; fi
  exit 0
}

# The guard saw screenshot-relevant changes and could not clear them. Passing
# would be false assurance, so it refuses — and says exactly what it hit.
# llmlint: ignore[changed_behavior_has_e2e] This local Git-hook diagnostic/exit helper has no browser or render path; callers are exercised at the hook's real subprocess boundary, while browser journeys remain owned by the capture targets it dispatches.
block_push() {
  local reason="$1"
  shift
  {
    echo
    echo "############################################################################"
    echo "#  screencomp pre-push guard: PUSH BLOCKED"
    echo "############################################################################"
    echo "#  $reason"
    local detail
    for detail in "$@"; do echo "#  $detail"; done
    echo "#"
    echo "#  To bypass: git push --no-verify"
    echo "############################################################################"
    echo
  } >&2
  exit 1
}

# No-op under CI: the visual-docs workflow already captures and classifies there.
if [ -n "${CI:-}" ]; then
  exit 0
fi

# Without the CLI the guard cannot evaluate the push.
if ! command -v screencomp >/dev/null 2>&1; then
  # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook dependency failure has no browser render path; visual-guard-hook.spec.ts runs the real hook in an uninstalled clone and verifies it announces the unevaluated push.
  skip_unevaluated \
    "screencomp is not on PATH" \
    "Install it with 'just bootstrap', then: git config core.hooksPath .githooks"
fi

ranges=()
zero='^0+$'
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  if [[ "$local_sha" =~ $zero ]]; then
    continue # branch deletion
  elif [[ "$remote_sha" =~ $zero ]]; then
    base="$(git merge-base origin/HEAD "$local_sha" 2>/dev/null || true)"
    if [ -n "$base" ]; then ranges+=("${base}..${local_sha}"); else ranges+=("$local_sha"); fi
  else
    ranges+=("${remote_sha}..${local_sha}")
  fi
done
if [ "${#ranges[@]}" -eq 0 ]; then
  exit 0
fi
# `|| exit` inside the subshell propagates a failing git diff (a range naming
# commits this clone does not have) out through pipefail, so a bad range reports
# instead of yielding a silently empty file list — which would read as "nothing
# screenshot-relevant changed" and pass the push.
changed=""
if ! changed="$(for r in "${ranges[@]}"; do git diff --name-only "$r" || exit; done | sort -u)"; then
  # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook failure has no browser render path; visual-guard-hook.spec.ts drives the real hook through git's stdin ref protocol and asserts the diagnostic and exit status.
  skip_unevaluated \
    "'git diff' could not list this push's changed files (range(s): ${ranges[*]})" \
    "Its error is above; the range may name commits this clone does not have."
fi

# `set +e` around the pipeline is what keeps the non-zero scope statuses — both
# the meaningful 3 and the failures — readable instead of fatal.
# llmlint: ignore[boundary_inputs_validated] SCREENCOMP_CONFIG is an optional screencomp-owned path; this invocation is its trust boundary, and any missing, unreadable, or invalid config produces a checked nonzero status that skip_unevaluated reports instead of being interpreted as a clean scope.
set +e
printf '%s\n' "$changed" | screencomp scope --config "$CONFIG" --changed-from - --exit-code --quiet
scope_status=$?
set -e
case "$scope_status" in
  0) exit 0 ;; # nothing relevant: an evaluated pass, the one quiet exit
  3) : ;;      # relevant path matched: fall through
  *)
    # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook scope-tool failure has no browser render path; no site artifact is produced or changed when the developer-side scope evaluation cannot run.
    skip_unevaluated \
      "'screencomp scope' exited $scope_status, so whether this push touches screenshots is unknown" \
      "Its error is above; check $CONFIG and the installed screencomp version."
    ;;
esac

range_base="${ranges[0]%%..*}"
range_head="${ranges[0]##*..}"
nx_args=(show projects --with-target screenshot --json)
if [ "$range_base" = "$range_head" ]; then
  echo "pre-push: cannot derive an affected range from '$range_head'; capturing all screenshot projects." >&2
else
  nx_args=(show projects --affected --with-target screenshot --base="$range_base" --head="$range_head" --json)
fi
# `pnpm exec nx` needs an installed workspace, and a freshly created clone or
# worktree legitimately has no node_modules — `pnpm exec` then exits 254 for the
# missing binary, printing its diagnosis to the stdout this captures. Taking the
# status here instead of letting the assignment die under `set -e` is the whole
# point of this section: that death happened before any message below could run,
# so git reported a bare "failed to push some refs" and the reason was lost.
affected_json=""
nx_status=0
affected_json="$(pnpm exec nx "${nx_args[@]}")" || nx_status=$?
if [ "$nx_status" -ne 0 ]; then
  # Whatever nx or pnpm said went into the capture rather than to the terminal,
  # so replay it (bounded) as part of the diagnostic.
  nx_said=()
  while IFS= read -r line; do
    [ "${#nx_said[@]}" -ge 6 ] && break
    [ -n "$line" ] && nx_said+=("nx: $line")
  done <<<"$affected_json"
  # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook failure has no browser render path; visual-guard-hook.spec.ts runs an actual uninstalled clone through the hook's git stdin boundary and asserts both permissive and required-failure outcomes.
  skip_unevaluated \
    "'pnpm exec nx show projects' exited $nx_status, so the affected microfrontends are unknown" \
    ${nx_said[@]+"${nx_said[@]}"} \
    "In a fresh clone or worktree this means the workspace is not installed:" \
    "run 'just bootstrap' (or at minimum 'pnpm install --frozen-lockfile')," \
    "then push again for a real verdict."
fi
apps_list=""
parse_status=0
apps_list="$(printf '%s' "$affected_json" | node -e '
  const a = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
  if (!Array.isArray(a) || !a.every((x) => typeof x === "string" && /^[a-z][a-z0-9-]*$/.test(x)))
    throw new Error("expected a JSON array of Nx project names");
  process.stdout.write([...new Set(a)].sort().join("\n"));
')" || parse_status=$?
# An unreadable project list is not an empty one: without this the parse failure
# left `apps` empty and the hook announced "no microfrontend was affected — ok to
# push", passing a push it had not evaluated.
if [ "$parse_status" -ne 0 ]; then
  # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook parse failure has no browser render path; the hook validates Nx JSON before treating an empty list as an evaluated pass.
  skip_unevaluated \
    "the affected-project list from Nx could not be read (node exited $parse_status)" \
    "Expected a JSON array of project names; nx printed: $(printf '%.200s' "$affected_json")"
fi
apps=()
if [ -n "$apps_list" ]; then
  mapfile -t apps < <(printf '%s' "$apps_list")
fi
if [ "${#apps[@]}" -eq 0 ]; then
  # llmlint: ignore[changed_behavior_has_e2e] This is a developer-side evaluated Git-hook result with no browser render path; Nx found no screenshot-capable app whose standalone or host-composed UI could be exercised.
  echo "pre-push: screenshot-relevant files changed, but no microfrontend was affected — ok to push"
  exit 0
fi

# A worktree captured by an earlier, root-running copy of this hook still holds a
# shots/ tree this user cannot write into, and that alone wedges every push from
# it: the capture below and the review gallery further down both create
# directories inside it. Reclaim it rather than fail on it. shots/ holds nothing
# but regenerable capture output — baselines live under apps/<app>/visual/baseline
# — so clearing it is always safe. Entries this user owns come back with a chmod;
# entries another user owns can only be unlinked by that user, so the same kind of
# root container that wrote them removes them.
# llmlint: ignore[changed_behavior_has_e2e] This local Git-hook filesystem preflight has no browser or render path; visual-guard-hook.spec.ts drives the real executable over a worktree holding capture output it cannot write beside and asserts that it reclaims and reaches its own verdict.
reclaim_capture_tree() {
  # Nothing to reclaim, and nothing to create either: the capture makes its own
  # output directories, and as the invoking user they are this user's.
  if [ ! -e shots ]; then
    return
  fi
  # Either signal wedges the steps below: an entry this user does not own, which
  # is what a root-running capture left behind, or a directory this user does own
  # but cannot write into.
  local blocked
  blocked="$(find shots \( ! -user "$(id -u)" -o -type d ! -perm -u+w \) -print 2>/dev/null | head -n 1 || true)"
  if [ -z "$blocked" ]; then
    return
  fi
  echo "pre-push: $blocked cannot be written by $(id -un), so this worktree holds" >&2
  echo "          capture output the steps below cannot write beside; reclaiming it." >&2
  chmod -R u+rwX shots 2>/dev/null || true
  rm -rf shots 2>/dev/null || true
  if [ -e shots ]; then
    # Renaming the tree aside instead is not available: moving a directory to a
    # new parent rewrites its own '..' entry, which needs write permission on the
    # directory this user does not have. Emptying it from inside a root container
    # — the only writer it ever had — does.
    docker run --rm --platform="linux/amd64" -v "$PWD/shots:/shots" "$CONTAINER" \
      find /shots -mindepth 1 -delete >/dev/null 2>&1 || true
    rmdir shots 2>/dev/null || true
  fi
  if [ -e shots ]; then
    block_push \
      "This worktree's shots/ directory holds capture output owned by another user" \
      "that could not be removed, so the capture below cannot write into it." \
      "Remove it with elevated permissions (sudo rm -rf shots) and push again."
  fi
  mkdir -p shots ||
    block_push "Could not recreate this worktree's shots/ directory (error above)."
  echo "pre-push: reclaimed shots/; the steps below can write into it again." >&2
}
reclaim_capture_tree

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook refusal has no browser render path; visual-guard-hook.spec.ts drives the real hook to this public failure outcome and asserts its exit and diagnostic.
  block_push \
    "Screenshot-relevant files changed in ${apps[*]}, but Docker is not available" \
    "to re-capture them. Start Docker and retry."
fi

# Everything the capture writes lands in this bind-mounted worktree, so the
# container runs as the user invoking the hook instead of as root. As root it
# created shots/ and shots/current/ owned by root at 0755; control then came back
# to this host-side script, which has to create shots/review/<app> beside them
# below, and that failed with EACCES — a filesystem-ownership problem wearing a
# visual-drift diagnostic. Running as the pusher keeps every artifact the
# pusher's, so each later step can write next to it.
host_user="$(id -u):$(id -g)"

# The container's /work/node_modules mask has to be a directory this user owns.
# The anonymous Docker volume that used to provide it is created root-owned, so a
# container running as the pusher cannot install into it. This scratch directory
# supplies that mask and, because an arbitrary uid has no home inside the image,
# the container HOME and corepack shim directory as well. It is removed when the
# hook exits, however it exits.
container_scratch=""
# llmlint: ignore[changed_behavior_has_e2e] This local Git-hook cleanup handler has no browser or render path; it only removes the hook's own host-side scratch directory.
# shellcheck disable=SC2329  # invoked by the EXIT trap below, not by name.
remove_container_scratch() {
  if [ -n "$container_scratch" ]; then rm -rf "$container_scratch"; fi
}
trap remove_container_scratch EXIT
if ! container_scratch="$(mktemp -d "${TMPDIR:-/tmp}/screencomp-guard-XXXXXX")"; then
  # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook failure has no browser render path; it guards scratch storage before any browser capture can start.
  block_push "Could not create a scratch directory for the capture container (error above)."
fi
mkdir -p "$container_scratch/node_modules" "$container_scratch/home" "$container_scratch/bin"

# Pass the host CA bundle into the container so a TLS-intercepting proxy does not
# break `pnpm install`; no-op when none is configured.
ca_args=()
host_ca="${NODE_EXTRA_CA_CERTS:-${SSL_CERT_FILE:-}}"
if [ -n "$host_ca" ] && [ -f "$host_ca" ]; then
  ca_args+=(-v "$host_ca:/host-ca.crt:ro" -e NODE_EXTRA_CA_CERTS=/host-ca.crt -e SSL_CERT_FILE=/host-ca.crt)
fi

# Capture every affected app into shots/current/<app>/<arch> using the SAME
# container and Nx screenshot target as CI, so local bytes match. One install,
# then loop; the scratch mount over /work/node_modules masks the host tree for a
# clean install matching CI's fresh checkout.
echo "pre-push: capturing affected microfrontends (${apps[*]}) in $CONTAINER…" >&2
# Resolved before the run: a command substitution inside a simple command's
# arguments cannot fail the command, so an unresolvable HEAD would otherwise
# capture under an empty SOURCE_REVISION rather than report.
source_revision=""
if ! source_revision="$(git rev-parse HEAD)"; then
  # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook failure has no browser render path; it guards capture metadata before any browser capture can start.
  block_push "Could not resolve HEAD to stamp the capture's source revision (git's error is above)."
fi
if ! docker run --rm --platform="linux/amd64" --ipc=host --shm-size=2g \
  --user "$host_user" \
  -v "$PWD:/work" -v "$container_scratch/node_modules:/work/node_modules" \
  -v "$container_scratch:/guard" -w /work \
  -e HOME=/guard/home -e COREPACK_SHIMS=/guard/bin \
  -e "SCREENCOMP_APPS=${apps[*]}" -e "ARCH=$ARCH" \
  -e "SOURCE_REVISION=$source_revision" \
  ${ca_args[@]+"${ca_args[@]}"} \
  "$CONTAINER" \
  bash -lc '
    set -euo pipefail
    # The uid this runs as has no entry in the image passwd file, so HOME, the
    # pnpm store beneath it, and the corepack shims all live in the scratch mount
    # the hook owns: a non-root user cannot write corepack shims into the image
    # global bin directory.
    mkdir -p "$HOME" "$COREPACK_SHIMS"
    corepack enable --install-directory "$COREPACK_SHIMS"
    export PATH="$COREPACK_SHIMS:$PATH"
    pnpm install --frozen-lockfile
    for app in $SCREENCOMP_APPS; do
      echo "::capture $app::"
      SHOTS_OUT="shots/current/$app/$ARCH" pnpm exec nx run "$app:screenshot"
    done
  '; then
  # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook subprocess failure has no standalone or host-composed render path; the real browser capture command failed before it could produce an artifact to test in either path.
  block_push \
    "Capturing ${apps[*]} in $CONTAINER failed; the container's output is above." \
    "Nothing was classified, so this push cannot be cleared of visual drift."
fi

drifted=()
for app in "${apps[@]}"; do
  manifest="apps/$app/visual/baseline/$ARCH.json"
  set +e
  screencomp classify --baseline-manifest "$manifest" --current "shots/current/$app" --arch "$ARCH" --exit-code --quiet
  status=$?
  set -e
  case "$status" in
    0) echo "pre-push: $app unchanged against $manifest" ;;
    3)
      drifted+=("$app")
      # Regenerate the drifted app's manifest and a review gallery. Never commit.
      # Both are what makes the block below actionable, so a failure here has to
      # name itself rather than end the hook on the drift it already found.
      if ! screencomp manifest --input "shots/current/$app" --arch "$ARCH" --output "$manifest"; then
        # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook tooling failure has no browser render path; it occurs while regenerating review metadata after the real capture and classification already found drift.
        block_push \
          "$app drifted from $manifest, but regenerating that baseline failed (error above)." \
          "Review the drift by hand; there is no updated manifest to commit."
      fi
      if ! screencomp gallery --input "shots/current/$app" --arch "$ARCH" \
        --output "shots/review/$app" --title "Pre-push review: $app" >/dev/null; then
        # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook tooling failure has no browser render path; it occurs while rendering review output after the real capture and classification already found drift.
        block_push \
          "$app drifted from $manifest, but building its review gallery failed (error above)." \
          "The regenerated manifest is written; there is no gallery to review it against."
      fi
      ;;
    *)
      # llmlint: ignore[changed_behavior_has_e2e] This local Git-hook classifier failure has no browser render path; it reports a tool error rather than a site behavior that can be exercised standalone or host-composed.
      block_push \
        "'screencomp classify' exited $status for $app against $manifest (error above)," \
        "so this push cannot be cleared of visual drift."
      ;;
  esac
done

if [ "${#drifted[@]}" -eq 0 ]; then
  echo "pre-push: all affected microfrontends match their baselines — ok to push"
  exit 0
fi

{
  echo
  echo "############################################################################"
  echo "#  SCREENSHOTS CHANGED — push blocked for review                            #"
  echo "############################################################################"
  echo "#"
  echo "#  Drifted microfrontend(s): ${drifted[*]}"
  echo "#"
  echo "#  Review each rendered gallery to confirm the change is intended:"
  for app in "${drifted[@]}"; do
    echo "#      shots/review/$app/index.html"
  done
  echo "#"
  echo "#  If intended, commit the regenerated baseline manifest(s) and push again:"
  for app in "${drifted[@]}"; do
    echo "#      git add apps/$app/visual/baseline/$ARCH.json"
  done
  echo "#      git commit -m 'chore(visual): update screenshot baselines'"
  echo "#      git push"
  echo "#"
  echo "#  If NOT intended: investigate the diff. To bypass: git push --no-verify"
  echo "#"
  echo "############################################################################"
  echo
} >&2
exit 1
