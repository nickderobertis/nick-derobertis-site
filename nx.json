{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/biome.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{options.outputPath}"]
    },
    "test": { "cache": true },
    "lint": { "cache": true },
    "typecheck": { "cache": true },
    "screenshot": {
      "cache": false,
      "dependsOn": [
        "build",
        {
          "target": "build",
          "projects": [
            "home",
            "home-carousel",
            "home-contact",
            "home-cards",
            "home-story",
            "timeline",
            "skills",
            "awards",
            "bio",
            "research",
            "software",
            "courses"
          ]
        },
        { "target": "prerender", "projects": ["shell"] }
      ]
    }
  },
  "plugins": []
}
