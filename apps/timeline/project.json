{
  "name": "timeline",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/timeline/src",
  "projectType": "application",
  "tags": ["type:remote", "scope:timeline"],
  "metadata": {
    "federation": { "alias": "timeline" },
    "boundaries": {
      "onlyDependOnLibsWithTags": [
        "type:shared",
        "type:data-core",
        "data:timeline"
      ]
    }
  },
  "targets": {
    "e2e": {
      "metadata": {
        "description": "llmlint: ignore[browser_journeys_run_against_the_built_app] This journey already runs against the built app: the target depends on shell:prerender, so Playwright drives the composed, prerendered artifact the deploy publishes, through this app's standalone document and its host-composed boundary alike. What the rule asks for beyond that is a separate e2e project, and this workspace deliberately gives each app its own journeys -- AGENTS.md makes coverage and capture the property of the app whose scenarios they are, scripts/workspace/structure-contract.spec.ts derives the owed project set from that sentence, and .github/CODEOWNERS routes each app subtree to its owner, so a separate project would move a remote's journeys out from under all three."
      },
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "prerender", "projects": ["shell"] }],
      "options": {
        "command": "playwright test --config apps/timeline/e2e/playwright.config.ts"
      }
    },
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{workspaceRoot}/dist/mf-types/remotes/timeline",
        "{workspaceRoot}/dist/mf-types/remotes/timeline.zip",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/timeline/rspack.config.ts",
        "outputPath": "dist/apps/timeline",
        "main": "apps/timeline/src/main.tsx",
        "tsConfig": "apps/timeline/tsconfig.app.json",
        "index": "apps/timeline/src/index.html",
        "assets": []
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint apps/timeline" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/timeline/tsconfig.app.json && tsc -p apps/timeline/e2e/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/timeline"],
      "options": {
        "command": "vitest run --config apps/timeline/vite.config.ts --coverage"
      }
    },
    "screenshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/timeline/visual/capture.ts \"${SHOTS_OUT:-shots/current/timeline/x86_64}\""
      }
    }
  }
}
