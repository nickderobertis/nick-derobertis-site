{
  "name": "timeline",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/timeline/src",
  "projectType": "application",
  "tags": ["type:remote", "scope:timeline"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "prerender", "projects": ["shell"] }],
      "options": {
        "command": "playwright test --config apps/timeline/e2e/playwright.config.ts"
      }
    },
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/timeline/rspack.config.ts",
        "outputPath": "dist/apps/timeline",
        "main": "apps/timeline/src/main.tsx",
        "tsConfig": "apps/timeline/tsconfig.app.json",
        "index": "apps/timeline/src/index.html",
        "assets": []
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint apps/timeline" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/timeline/tsconfig.app.json && tsc -p apps/timeline/e2e/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/timeline"],
      "options": {
        "command": "vitest run --config apps/timeline/vite.config.ts --coverage"
      }
    },
    "screenshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/timeline/visual/capture.ts \"${SHOTS_OUT:-shots/current/timeline/x86_64}\""
      }
    }
  }
}
