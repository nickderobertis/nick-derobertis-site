{
  "name": "skills",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/skills/src",
  "projectType": "application",
  "tags": ["type:remote", "scope:skills"],
  "metadata": {
    "federation": { "alias": "skills" },
    "boundaries": {
      "onlyDependOnLibsWithTags": [
        "type:shared",
        "type:data-core",
        "data:skills"
      ]
    }
  },
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "prerender", "projects": ["shell"] }],
      "options": {
        "command": "playwright test --config apps/skills/e2e/playwright.config.ts"
      }
    },
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{workspaceRoot}/dist/mf-types/remotes/skills",
        "{workspaceRoot}/dist/mf-types/remotes/skills.zip",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/skills/rspack.config.ts",
        "outputPath": "dist/apps/skills",
        "main": "apps/skills/src/main.tsx",
        "tsConfig": "apps/skills/tsconfig.app.json",
        "index": "apps/skills/src/index.html",
        "assets": []
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint apps/skills" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/skills/tsconfig.app.json && tsc -p apps/skills/e2e/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/skills"],
      "options": {
        "command": "vitest run --config apps/skills/vite.config.ts --coverage"
      }
    },
    "screenshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/skills/visual/capture.ts \"${SHOTS_OUT:-shots/current/skills/x86_64}\""
      }
    }
  }
}
