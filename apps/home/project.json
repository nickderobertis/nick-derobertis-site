{
  "name": "home",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/home/src",
  "projectType": "application",
  "tags": ["type:remote", "scope:home"],
  "metadata": {
    "federation": { "alias": "home" },
    "boundaries": {
      "onlyDependOnLibsWithTags": [
        "type:shared",
        "type:data-core",
        "data:home",
        "scope:home-carousel",
        "scope:home-cards",
        "scope:home-story",
        "scope:home-contact",
        "scope:skills"
      ]
    }
  },
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "prerender", "projects": ["shell"] }],
      "options": {
        "command": "playwright test --config apps/home/e2e/playwright.config.ts"
      }
    },
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/home/rspack.config.ts",
        "outputPath": "dist/apps/home",
        "main": "apps/home/src/main.tsx",
        "tsConfig": "apps/home/tsconfig.app.json",
        "index": "apps/home/src/index.html",
        "assets": []
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint apps/home" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/home/tsconfig.app.json && tsc -p apps/home/e2e/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/home"],
      "options": {
        "command": "vitest run --config apps/home/vite.config.ts --coverage"
      }
    },
    "screenshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/home/visual/capture.ts \"${SHOTS_OUT:-shots/current/home/x86_64}\""
      }
    }
  }
}
