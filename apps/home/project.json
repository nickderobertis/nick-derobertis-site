{
  "name": "home",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/home/src",
  "projectType": "application",
  "tags": ["type:remote", "scope:home"],
  "metadata": {
    "federation": { "alias": "home" },
    "boundaries": {
      "onlyDependOnLibsWithTags": [
        "type:shared",
        "type:data-core",
        "data:home",
        "scope:home-carousel",
        "scope:home-cards",
        "scope:home-story",
        "scope:home-contact",
        "scope:timeline",
        "scope:skills",
        "scope:awards"
      ]
    }
  },
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "prerender", "projects": ["shell"] }],
      "options": {
        "command": "playwright test --config apps/home/e2e/playwright.config.ts"
      }
    },
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/home/rspack.config.ts",
        "outputPath": "dist/apps/home",
        "main": "apps/home/src/main.tsx",
        "tsConfig": "apps/home/tsconfig.app.json",
        "index": "apps/home/src/index.html",
        "assets": []
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint apps/home" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/home/tsconfig.app.json && tsc -p apps/home/e2e/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/home"],
      "options": {
        "command": "vitest run --config apps/home/vite.config.ts --coverage"
      }
    },
    "screenshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/home/visual/capture.ts \"${SHOTS_OUT:-shots/current/home/x86_64}\""
      }
    },
    "serve": {
      "executor": "@nx/rspack:dev-server",
      "metadata": {
        "description": "llmlint: ignore[changed_behavior_has_e2e] This target only declares the shared @nx/rspack:dev-server executor for home; it builds no byte a visitor is served, because just serve-dev composes the published artifact for every app it is not developing. The one code path the declaration reaches is scripts/serve/serve-dev.mjs, and serve-dev.spec.ts drives that path in a real browser through both shapes an app can take under it \u2014 the composing host (shell) and a remote pane (awards), whose edit it also follows into the composed host \u2014 while apps/home/e2e/home.spec.ts and apps/home/e2e/ownership.spec.ts keep home's published bytes covered standalone and host-composed."
      },
      "options": { "buildTarget": "home:build" }
    }
  }
}
