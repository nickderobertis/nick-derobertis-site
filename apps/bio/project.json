{
  "name": "bio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bio/src",
  "projectType": "application",
  "tags": ["type:remote", "scope:bio"],
  "metadata": {
    "federation": { "alias": "bio" },
    "boundaries": {
      "onlyDependOnLibsWithTags": ["type:shared"]
    }
  },
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "prerender", "projects": ["shell"] }],
      "options": {
        "command": "playwright test --config apps/bio/e2e/playwright.config.ts"
      }
    },
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/bio/rspack.config.ts",
        "outputPath": "dist/apps/bio",
        "main": "apps/bio/src/main.tsx",
        "tsConfig": "apps/bio/tsconfig.app.json",
        "index": "apps/bio/src/index.html",
        "assets": []
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint apps/bio" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/bio/tsconfig.app.json && tsc -p apps/bio/e2e/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/bio/vite.config.ts --coverage"
      }
    },
    "screenshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/bio/visual/capture.ts \"${SHOTS_OUT:-shots/current/bio/x86_64}\""
      }
    },
    "serve": {
      "executor": "@nx/rspack:dev-server",
      "metadata": {
        "description": "llmlint: ignore[changed_behavior_has_e2e] This target only declares the shared @nx/rspack:dev-server executor for bio; it builds no byte a visitor is served, because just serve-dev composes the published artifact for every app it is not developing. The one code path the declaration reaches is scripts/serve/serve-dev.mjs, and serve-dev.spec.ts drives that path in a real browser through both shapes an app can take under it \u2014 the composing host (shell) and a remote pane (awards), whose edit it also follows into the composed host \u2014 while apps/bio/e2e/bio.spec.ts and apps/bio/e2e/ownership.spec.ts keep bio's published bytes covered standalone and host-composed."
      },
      "options": { "buildTarget": "bio:build" }
    }
  }
}
