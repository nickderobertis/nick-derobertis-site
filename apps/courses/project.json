{
  "name": "courses",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/courses/src",
  "projectType": "application",
  "tags": ["type:remote", "scope:courses"],
  "metadata": {
    "federation": { "alias": "courses" },
    "boundaries": {
      "onlyDependOnLibsWithTags": [
        "type:shared",
        "type:data-core",
        "data:courses"
      ]
    }
  },
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "prerender", "projects": ["shell"] }],
      "options": {
        "command": "playwright test --config apps/courses/e2e/playwright.config.ts"
      }
    },
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/courses/rspack.config.ts",
        "outputPath": "dist/apps/courses",
        "main": "apps/courses/src/main.tsx",
        "tsConfig": "apps/courses/tsconfig.app.json",
        "index": "apps/courses/src/index.html",
        "assets": []
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint apps/courses" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/courses/tsconfig.app.json && tsc -p apps/courses/e2e/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/courses/vite.config.ts --coverage"
      }
    },
    "screenshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/courses/visual/capture.ts \"${SHOTS_OUT:-shots/current/courses/x86_64}\""
      }
    },
    "serve": {
      "executor": "@nx/rspack:dev-server",
      "options": {
        "buildTarget": "courses:build",
        "port": 4200,
        "host": "127.0.0.1"
      }
    }
  }
}
