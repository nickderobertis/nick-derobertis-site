{
  "name": "home-contact",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/home-contact/src",
  "projectType": "application",
  "tags": ["type:remote", "scope:home-contact"],
  "metadata": {
    "federation": { "alias": "homeContact" },
    "boundaries": {
      "onlyDependOnLibsWithTags": ["type:shared", "type:data-core", "data:home"]
    }
  },
  "targets": {
    "e2e": {
      "metadata": {
        "description": "llmlint: ignore[browser_journeys_run_against_the_built_app] This journey already runs against the built app: the target depends on shell:prerender, so Playwright drives the composed, prerendered artifact the deploy publishes, through this app's standalone document and its host-composed boundary alike. What the rule asks for beyond that is a separate e2e project, and this workspace deliberately gives each app its own journeys -- AGENTS.md makes coverage and capture the property of the app whose scenarios they are, scripts/workspace/structure-contract.spec.ts derives the owed project set from that sentence, and .github/CODEOWNERS routes each app subtree to its owner, so a separate project would move a remote's journeys out from under all three."
      },
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "prerender", "projects": ["shell"] }],
      "options": {
        "command": "playwright test --config apps/home-contact/e2e/playwright.config.ts"
      }
    },
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{workspaceRoot}/dist/mf-types/remotes/homeContact",
        "{workspaceRoot}/dist/mf-types/remotes/homeContact.zip",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/home-contact/rspack.config.ts",
        "outputPath": "dist/apps/home-contact",
        "main": "apps/home-contact/src/main.tsx",
        "tsConfig": "apps/home-contact/tsconfig.app.json",
        "index": "apps/home-contact/src/index.html",
        "assets": []
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint apps/home-contact" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/home-contact/tsconfig.app.json && tsc -p apps/home-contact/e2e/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/home-contact"],
      "options": {
        "command": "vitest run --config apps/home-contact/vite.config.ts --coverage"
      }
    },
    "screenshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/home-contact/visual/capture.ts \"${SHOTS_OUT:-shots/current/home-contact/x86_64}\""
      }
    }
  }
}
