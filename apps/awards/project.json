{
  "name": "awards",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/awards/src",
  "projectType": "application",
  "tags": ["type:remote", "scope:awards"],
  "metadata": {
    "federation": { "alias": "awards" },
    "boundaries": {
      "onlyDependOnLibsWithTags": [
        "type:shared",
        "type:data-core",
        "data:awards"
      ]
    }
  },
  "targets": {
    "e2e": {
      "metadata": {
        "description": "llmlint: ignore[browser_journeys_run_against_the_built_app] This journey already runs against the built app: the target depends on shell:prerender, so Playwright drives the composed, prerendered artifact the deploy publishes, through this app's standalone document and its host-composed boundary alike. What the rule asks for beyond that is a separate e2e project, and this workspace deliberately gives each app its own journeys -- AGENTS.md makes coverage and capture the property of the app whose scenarios they are, scripts/workspace/structure-contract.spec.ts derives the owed project set from that sentence, and .github/CODEOWNERS routes each app subtree to its owner, so a separate project would move a remote's journeys out from under all three."
      },
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "prerender", "projects": ["shell"] }],
      "options": {
        "command": "playwright test --config apps/awards/e2e/playwright.config.ts"
      }
    },
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{workspaceRoot}/dist/mf-types/remotes/awards",
        "{workspaceRoot}/dist/mf-types/remotes/awards.zip",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/awards/rspack.config.ts",
        "outputPath": "dist/apps/awards",
        "main": "apps/awards/src/main.tsx",
        "tsConfig": "apps/awards/tsconfig.app.json",
        "index": "apps/awards/src/index.html",
        "assets": []
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint apps/awards" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/awards/tsconfig.app.json && tsc -p apps/awards/e2e/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/awards"],
      "options": {
        "command": "vitest run --config apps/awards/vite.config.ts --coverage"
      }
    },
    "screenshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/awards/visual/capture.ts \"${SHOTS_OUT:-shots/current/awards/x86_64}\""
      }
    }
  }
}
