{
  "name": "research",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/research/src",
  "projectType": "application",
  "tags": ["type:remote", "scope:research"],
  "metadata": {
    "federation": { "alias": "research" },
    "boundaries": {
      "onlyDependOnLibsWithTags": [
        "type:shared",
        "type:data-core",
        "data:research"
      ]
    }
  },
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "prerender", "projects": ["shell"] }],
      "options": {
        "command": "playwright test --config apps/research/e2e/playwright.config.ts"
      }
    },
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/research/rspack.config.ts",
        "outputPath": "dist/apps/research",
        "main": "apps/research/src/main.tsx",
        "tsConfig": "apps/research/tsconfig.app.json",
        "index": "apps/research/src/index.html",
        "assets": []
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint apps/research" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/research/tsconfig.app.json && tsc -p apps/research/e2e/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/research/vite.config.ts --coverage"
      }
    },
    "screenshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/research/visual/capture.ts \"${SHOTS_OUT:-shots/current/research/x86_64}\""
      }
    },
    "serve": {
      "executor": "@nx/rspack:dev-server",
      "options": { "buildTarget": "research:build" }
    }
  }
}
