{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/shell/src",
  "projectType": "application",
  "tags": ["type:app", "scope:shell"],
  "targets": {
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": [
        "{options.outputPath}",
        "{options.outputPath}/fragment.html",
        "{options.outputPath}/fragment.css",
        "{options.outputPath}/fragment.json"
      ],
      "options": {
        "rspackConfig": "apps/shell/rspack.config.ts",
        "outputPath": "dist/apps/shell",
        "index": "apps/shell/src/index.html",
        "main": "apps/shell/src/main.tsx",
        "tsConfig": "apps/shell/tsconfig.app.json",
        "assets": []
      }
    },
    "serve": {
      "executor": "@nx/rspack:dev-server",
      "options": { "buildTarget": "shell:build", "port": 4200 }
    },
    "prerender": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "llmlint: ignore[changed_behavior_has_e2e] Nx dependency selection has no browser interface and remote-manifest.spec.ts exercises it at the project-graph contract; site.spec.ts drives the composed artifact with JavaScript disabled and through hydration, and every journey spec drives standalone and host-composed boundaries."
      },
      "dependsOn": [
        "build",
        {
          "target": "build",
          "projects": [
            "home",
            "home-carousel",
            "home-contact",
            "home-cards",
            "home-story",
            "timeline",
            "skills",
            "awards",
            "bio",
            "research",
            "software",
            "courses"
          ]
        }
      ],
      "options": {
        "command": "node scripts/compose.mjs && node scripts/check-static-artifact.mjs # llmlint: ignore[changed_behavior_has_e2e] Compose contract and filesystem failures happen before an artifact can be served, so compose.spec.ts exercises that real CLI boundary; site.spec.ts drives its successful output with and without JavaScript."
      }
    },
    "perf": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/performance-audit.mjs"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings=0 && biome lint apps/shell"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/shell/tsconfig.app.json" }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/shell"],
      "options": {
        "command": "vitest run --config apps/shell/vite.config.ts --coverage"
      }
    }
  }
}
