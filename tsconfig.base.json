{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "resolveJsonModule": true,
    // Build modules under libs/build-config/src and publish modules under
    // libs/publish-config/src are executed by
    // Node's type stripping from scripts/*/*.mjs, where the ESM resolver requires
    // the real file extension. Every project here already compiles with noEmit,
    // so permitting the `.ts` specifier changes nothing but resolution.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    // Module Federation's declaration generator derives its compile root from
    // the program's root files when none is set, and a remote's exposes reach
    // into libs/, so the root is pinned to the workspace that holds both.
    "rootDir": "."
  }
}
