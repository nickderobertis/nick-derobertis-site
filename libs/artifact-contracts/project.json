{
  "name": "artifact-contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/artifact-contracts/src",
  "projectType": "library",
  "tags": ["type:shared", "scope:build"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "biome lint libs/artifact-contracts" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/artifact-contracts/tsconfig.json" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/artifact-contracts/tsconfig.json" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests libs/artifact-contracts"
      }
    }
  }
}
