{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "types": ["node", "vitest/globals"] },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // Neither rspack entry is a root file of this program. The shell one is
  // still typechecked here: its spec pulls it back in, and
  // src/shell-fragment-modules.d.ts resolves what it imports.
  "exclude": ["src/remote-fragment-entry.tsx", "src/shell-fragment-entry.tsx"]
}
