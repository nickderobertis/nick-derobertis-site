{
  "name": "tooling-visual",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "scripts/visual",
  "projectType": "application",
  "tags": ["type:tooling", "scope:visual"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/ci/run-tooling-target.sh visual lint biome lint scripts/visual"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/ci/run-tooling-target.sh visual typecheck tsc -p scripts/visual/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/ci/run-tooling-target.sh visual test vitest run --reporter=dot --maxWorkers=1 --config scripts/visual/vite.config.ts"
      }
    }
  }
}
