{
  "name": "tooling-workspace",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "scripts/workspace",
  "projectType": "application",
  "tags": ["type:tooling", "scope:workspace"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome lint scripts/workspace"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p scripts/workspace/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --maxWorkers=1 --config scripts/workspace/vite.config.ts"
      }
    }
  }
}
